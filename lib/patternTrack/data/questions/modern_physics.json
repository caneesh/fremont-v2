    "source": "introductory_physics",
    "created_at": "2024-01-01T00:00:00Z",
    "updated_at": "2024-01-01T00:00:00Z"
  },
  {
    "id": "q_modern_016",
    "problem_text": "A radioactive isotope has a decay constant λ = 0.1 per day. What is its half-life?",
    "pattern_refs": [
      { "pattern_id": "pattern_radioactive_decay", "relevance": "primary", "application_notes": "Relationship between decay constant and half-life" }
    ],
    "difficulty": 2,
    "category": "modern_physics",
    "subcategory": "nuclear",
    "hints": [
      { "order": 1, "text": "What is the relationship between λ and half-life?", "pattern_id": "pattern_radioactive_decay" },
      { "order": 2, "text": "t_half = ln(2)/λ" },
      { "order": 3, "text": "ln(2) ≈ 0.693" }
    ],
    "answer": { "type": "numeric", "value": 6.93, "unit": "days", "tolerance": 0.1 },
    "solution_explanation": "t_half = ln(2)/λ = 0.693/0.1 = 6.93 days.",
    "tags": ["decay_constant", "half_life", "radioactive"],
    "source": "introductory_physics",
    "created_at": "2024-01-01T00:00:00Z",
    "updated_at": "2024-01-01T00:00:00Z"
  },
  {
    "id": "q_modern_017",
    "problem_text": "In nuclear fusion, 4 protons combine to form a helium-4 nucleus. If the mass defect is 0.029 u, how much energy is released? (1 u = 931.5 MeV/c²)",
    "pattern_refs": [
      { "pattern_id": "pattern_mass_energy", "relevance": "primary", "application_notes": "Mass defect to energy conversion" },
      { "pattern_id": "pattern_nuclear_binding", "relevance": "secondary", "application_notes": "Binding energy from mass defect" }
    ],
    "difficulty": 2,
    "category": "modern_physics",
    "subcategory": "nuclear",
    "hints": [
      { "order": 1, "text": "Use E = Δmc².", "pattern_id": "pattern_mass_energy" },
      { "order": 2, "text": "1 u of mass is equivalent to 931.5 MeV of energy." },
      { "order": 3, "text": "E = (0.029 u)(931.5 MeV/u)" }
    ],
    "answer": { "type": "numeric", "value": 27.0, "unit": "MeV", "tolerance": 0.5 },
    "solution_explanation": "E = Δmc² = (0.029 u)(931.5 MeV/u) = 27.0 MeV.",
    "tags": ["fusion", "mass_defect", "binding_energy"],
    "source": "introductory_physics",
    "created_at": "2024-01-01T00:00:00Z",
    "updated_at": "2024-01-01T00:00:00Z"
  },
  {
    "id": "q_modern_018",
    "problem_text": "A proton (m = 1.67 × 10⁻²⁷ kg) is accelerated to 0.5c. What is its relativistic kinetic energy in MeV? (c = 3 × 10⁸ m/s, 1 MeV = 1.6 × 10⁻¹³ J)",
    "pattern_refs": [
      { "pattern_id": "pattern_relativity_energy", "relevance": "primary", "application_notes": "Relativistic kinetic energy" }
    ],
    "difficulty": 3,
    "category": "modern_physics",
    "subcategory": "relativity",
    "hints": [
      { "order": 1, "text": "What is the formula for relativistic KE?", "pattern_id": "pattern_relativity_energy" },
      { "order": 2, "text": "KE = (γ - 1)mc²" },
      { "order": 3, "text": "First calculate γ = 1/√(1 - 0.25)." }
    ],
    "answer": { "type": "numeric", "value": 145, "unit": "MeV", "tolerance": 5 },
    "solution_explanation": "γ = 1/√(1 - 0.25) = 1/√0.75 = 1.155. m_p c² = (1.67 × 10⁻²⁷)(9 × 10¹⁶)/(1.6 × 10⁻¹³) = 938 MeV. KE = (γ - 1)m_p c² = (0.155)(938) = 145 MeV.",
    "tags": ["relativistic_KE", "proton", "gamma_factor"],
    "source": "introductory_physics",
    "created_at": "2024-01-01T00:00:00Z",
    "updated_at": "2024-01-01T00:00:00Z"
  },
  {
    "id": "q_modern_019",
    "problem_text": "Which transition in hydrogen produces a photon with the longest wavelength in the Balmer series?",
    "pattern_refs": [
      { "pattern_id": "pattern_emission_spectra", "relevance": "primary", "application_notes": "Balmer series transitions" },
      { "pattern_id": "pattern_bohr_model", "relevance": "secondary", "application_notes": "Energy level differences" }
    ],
    "difficulty": 2,
    "category": "modern_physics",
    "subcategory": "atomic_spectra",
