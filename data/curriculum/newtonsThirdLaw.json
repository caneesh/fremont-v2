  "misconceptionCards": [
    {
      "id": "mc-n3l-001",
      "version": {
        "major": 1,
        "minor": 0,
        "patch": 0,
        "createdAt": "2026-01-11T00:00:00Z",
        "changelog": "Horse-cart paradox misconception"
      },
      "conceptNode": "newtons_third_law",
      "misconception": "If the horse pulls the cart with the same force the cart pulls the horse, they should cancel and nothing should move.",
      "origin": "Students apply the cancellation logic of forces on the same body to forces on different bodies.",
      "correctUnderstanding": "The two forces act on different bodies (horse and cart separately). For motion, we look at the net force on each body individually, not the sum of forces across bodies.",
      "triggerSituations": [
        "Any scenario where an object accelerates while apparently being pulled back equally",
        "Tug-of-war situations",
        "Pushing against a wall"
      ],
      "exposureQuestions": [
        "If the forces cancel, why does anything ever move?",
        "Draw the forces ON THE HORSE only. What do you see?",
        "What other force acts on the horse besides the cart's pull?"
      ],
      "refutationStrategy": {
        "probe": "If action equals reaction, how can anything accelerate?",
        "conflict": "Draw separate FBDs for the horse and the cart. On which body does the ground's friction act?",
        "reconstruction": "What determines whether the horse-cart system accelerates?"
      },
      "commonTraps": [
        "Adding forces across different bodies",
        "Forgetting the ground friction on the horse",
        "Not drawing separate FBDs"
      ],
      "severity": "critical",
      "foundationClassification": {
        "level": "foundation1",
        "focus": "FBD separation is essential to resolve this",
        "targetSkills": ["f1_representation", "f1_cause_effect"],
        "prerequisites": ["fbd_basics"]
      },
      "ragMetadata": {
        "contentType": "misconception_trap",
        "embeddable": true,
        "priority": 8,
        "retrievalTags": ["misconception", "horse_cart", "force_cancellation"],
        "exclusions": ["use_as_correct_physics"],
        "uncertainty": {
          "confident": true
        }
      }
    },
    {
      "id": "mc-n3l-002",
      "version": {
        "major": 1,
        "minor": 0,
        "patch": 0,
        "createdAt": "2026-01-11T00:00:00Z",
        "changelog": "Stronger object exerts more force misconception"
      },
      "conceptNode": "newtons_third_law",
      "misconception": "The stronger or larger object exerts a greater force in an interaction.",
      "origin": "Confusion between force and effect. A truck hitting a car causes more damage to the car, so students think the truck exerts more force.",
      "correctUnderstanding": "Force magnitudes are always equal regardless of size or strength. The effects differ because acceleration depends on mass (a = F/m).",
      "triggerSituations": [
        "Collisions between objects of different sizes",
        "A person pushing against a wall",
        "Earth pulling on an apple"
      ],
      "exposureQuestions": [
        "When a truck hits a car, which experiences more force?",
        "If you push a wall and it doesn't move, did you exert any force on it?",
        "Does the apple pull on the Earth?"
      ],
      "refutationStrategy": {
        "probe": "Does a heavier object push harder on a lighter object during collision?",
        "conflict": "If forces were unequal, what would Newton's Third Law say?",
        "reconstruction": "Why does the car get damaged more if the forces are equal?"
      },
      "commonTraps": [
        "Confusing force with acceleration",
        "Confusing force with damage or deformation",
        "Thinking mass determines force"
      ],
      "severity": "high",
      "foundationClassification": {
        "level": "foundation1",
        "focus": "Separating force from effect",
        "targetSkills": ["f1_qualitative_reasoning", "f1_comparison"],
        "prerequisites": ["force_concept", "acceleration_basics"]
      },
      "ragMetadata": {
        "contentType": "misconception_trap",
        "embeddable": true,
        "priority": 7,
        "retrievalTags": ["misconception", "force_magnitude", "mass_confusion"],
        "exclusions": ["use_as_correct_physics"],
        "uncertainty": {
          "confident": true
        }
      }
    }
  ],

