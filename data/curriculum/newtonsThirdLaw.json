  "conceptCard": {
    "id": "cc-n3l-001",
    "version": {
      "major": 1,
      "minor": 0,
      "patch": 0,
      "createdAt": "2026-01-11T00:00:00Z",
      "changelog": "Initial concept card"
    },
    "conceptNode": "newtons_third_law",
    "grade": "class9",
    "module": "laws_of_motion",
    "targetInsight": "Action-reaction force pairs act on different bodies and therefore do not cancel.",
    "mentalModel": {
      "description": "Every force is part of an interaction between two bodies. When body A pushes on body B, body B simultaneously pushes back on body A with equal magnitude but opposite direction. These two forces form an 'action-reaction pair' but they act on different objects, which is why they never cancel each other out.",
      "anchors": [
        "Two-body FBD with forces clearly on separate bodies",
        "Hands pushing against each other",
        "Feet pushing on ground while ground pushes back"
      ],
      "analogies": [
        "Like two people pushing shopping carts against each other - each person feels a push but the pushes are on different carts",
        "Like clapping - both hands feel the impact equally"
      ]
    },
    "prerequisites": ["force_concept", "interaction_concept", "fbd_basics"],
    "relatedNodes": ["newtons_first_law", "newtons_second_law", "friction"],
    "foundationClassification": {
      "level": "foundation1",
      "focus": "Intuition and FBD separation",
      "targetSkills": ["f1_qualitative_reasoning", "f1_representation", "f1_cause_effect"],
      "prerequisites": ["force_concept", "fbd_basics"]
    },
    "ragMetadata": {
      "contentType": "authoritative_fact",
      "embeddable": true,
      "priority": 10,
      "retrievalTags": ["newton", "third_law", "action_reaction", "force_pairs"],
      "exclusions": [],
      "uncertainty": {
        "confident": true
      }
    },
    "difficulty": {
      "conceptualLoad": {
        "level": "developing",
        "score": 2,
        "rationale": "Two concepts: force pairs and different bodies"
      },
      "reasoningDepth": {
        "level": "developing",
