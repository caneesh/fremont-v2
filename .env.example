# =============================================================================
# Fremont v2 - Physics Learning Platform
# Environment Variables Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# API KEYS (Required)
# -----------------------------------------------------------------------------

# Anthropic API Key - Required for AI-powered features
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# MathPix API keys - Required for MathPix-based PDF extraction scripts
# Get keys from: https://mathpix.com/
MATHPIX_APP_ID=your_app_id_here
MATHPIX_APP_KEY=your_app_key_here

# -----------------------------------------------------------------------------
# VERCEL SERVICES (Required for Question Scaffolding Engine)
# -----------------------------------------------------------------------------

# Redis - Used for caching, rate limiting, and indexing
# Create a Redis database in your Vercel dashboard (Storage > Redis), then copy the URL
REDIS_URL=your_redis_url

# Vercel Blob - Used for immutable question storage
# Enable Blob in your Vercel project settings, then create a token
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Features marked "Always ON" don't need configuration.
# Features marked "Dev Only" are ON in development, OFF in production by default.
# Set to "true" to enable in production, "false" to disable in development.
# -----------------------------------------------------------------------------

# --- ALWAYS ON (no configuration needed) ---
# MICRO_TASKS=true          # Active learning with MCQ/fill-blank tasks
# MISTAKE_NOTEBOOK=true     # Spaced repetition mistake tracking
# ERROR_ANTICIPATOR=true    # Warning beacons for common mistakes

# --- DEV ONLY BY DEFAULT (set to "true" for production) ---

# Reveal-Reconstruct-Validate Flow
# 3-stage structured learning flow for reading mode:
# 1. REVEAL: Structured explanation with scannable sections
# 2. RECONSTRUCT: Comprehension check questions
# 3. VALIDATE: Confidence-weighted feedback
NEXT_PUBLIC_FEATURE_REVEAL_RECONSTRUCT_VALIDATE=true

# Confidence-Weighted SRS
# Asks students to rate confidence after answering.
# Uses correctness x confidence matrix to adjust review scheduling:
# - Correct + High = accelerated review (mastery)
# - Correct + Low = sooner review (lucky guess)
# - Wrong + High = aggressive review (dangerous misconception)
NEXT_PUBLIC_FEATURE_CONFIDENCE_SRS=true

# Boundary-Case Builder
# Interactive tool to "stress test" equations with limiting cases.
# Examples: theta -> 0, m -> infinity
# Builds physical intuition and validates mathematical understanding.
NEXT_PUBLIC_FEATURE_BOUNDARY_CASE=true

# Equationless Path
# Requires verbal plan before algebra entry at Strategy-level steps.
# Forces students to articulate approach in words before equations.
NEXT_PUBLIC_FEATURE_EQUATIONLESS_PATH=true

# Concept Contrast Challenge
# Challenges students to explain why they rejected "neighboring" concepts.
# Forces deep understanding by articulating why similar laws don't apply.
NEXT_PUBLIC_FEATURE_CONCEPT_CONTRAST=true

# --- DISABLED BY DEFAULT (set to "true" to enable) ---

# Free Body Diagram Canvas
# Interactive force diagram drawing tool for mechanics problems.
# Includes force palette, snap angles, and validation.
NEXT_PUBLIC_ENABLE_FBD=false

# -----------------------------------------------------------------------------
# ALWAYS-ON SYSTEMS (no configuration - informational only)
# -----------------------------------------------------------------------------
# These systems are always active and cannot be disabled:
#
# - Circuit Breaker: Error pattern detection and remedial drills
# - Constraint Collision Engine: Detects contradictions with problem constraints
# - Misconception Detection: Identifies 12 major physics misconception patterns
# - Socratic Rewind: Guides students back using Socratic method
# - Pre-Flight Checks: Formula condition validation before law usage
# - Sanity Check Matrix: 3-pronged verification (limit, symmetry, dimension)
# - Solution Grading: Diagnostic grading with error categorization
# - Paper Solution Upload: Handwriting OCR and analysis
# - Interactive Simulations: Projectile motion, inclined plane, what-if scenarios
# - Feynman Technique Prompts: Conceptual verification through teaching
# - Explain to Friend: 3-line Feynman summary
# - Spot the Mistake: Flawed solution analysis practice

# -----------------------------------------------------------------------------
# QUICK SETUP FOR PRODUCTION (Vercel)
# -----------------------------------------------------------------------------
# Copy these lines to enable all features in production:
#
# NEXT_PUBLIC_FEATURE_REVEAL_RECONSTRUCT_VALIDATE=true
# NEXT_PUBLIC_FEATURE_CONFIDENCE_SRS=true
# NEXT_PUBLIC_FEATURE_BOUNDARY_CASE=true
# NEXT_PUBLIC_FEATURE_EQUATIONLESS_PATH=true
# NEXT_PUBLIC_FEATURE_CONCEPT_CONTRAST=true
# NEXT_PUBLIC_ENABLE_FBD=true
